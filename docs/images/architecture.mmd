flowchart TB
  subgraph In[Inputs]
    SENS[Motion and presence sensors]
    LUX[Illuminance]
  end
  subgraph Style[Styling over the day]
    HS[house-schedule<br/>configuration node]
    CIRC[circadian-lighting-policy]
  end
  subgraph Room[Room lighting]
    OCC[occupancy-fusion]
    MOT[motion-lighting-policy]
    SW[switch-lighting-policy]
    ROOM[room-lighting-controller]
  end
  subgraph Cov[Covers]
    GRP[cover-group]
    COV[cover-controller]
  end
  subgraph Act[Theatre activities]
    CON[theatre-state-contract]
    ACT["theatre-activity-<br/>controller"]
    ROUTE{{your flow: route by target}}
    AL["activity-lighting-<br/>controller"]
    EQ[avr / display-mode /<br/>source-capability /<br/>backlighting controllers]
  end
  subgraph Adapt[Device adapters]
    ZL[z2m-light]
    SS[shelly-switch]
    ZC[z2m-cover]
    SC[shelly-cover]
    WL[wled]
    ZP[z2m-power]
    ZS[z2m-sensor /<br/>ESPHome sensors]
  end
  BROKER[(MQTT broker)]
  HA[Home Assistant: the panel<br/>shows state, sends set messages]
  DEV[(Devices: Zigbee2MQTT lights, covers and sensors,<br/>Shelly switches and covers,<br/>a WLED TV backlight)]
  AV[(AV device transports)]

  SENS --> ZS
  ZS -- motion and presence --> OCC
  OCC --> MOT
  ZS -- light level --> MOT
  LUX --> MOT
  HS -. times, without wires .-> CIRC
  CIRC -- style --> ROOM
  MOT -- intents --> ROOM
  SW -- intents --> ROOM
  GRP --> COV
  COV -. moving: pause .-> MOT

  ROOM <-- neutral light commands and readings --> ZL
  COV <-- neutral cover commands and readings --> ZC
  COV <-- neutral cover commands and readings --> SC
  SS -- wall switch presses --> SW

  CON -- activity intent --> ACT
  ACT -- state snapshot --> CON
  ACT -- theatreCommand --> ROUTE
  ROUTE --> EQ
  ROUTE --> AL
  EQ -. target state .-> ACT
  AL -. target state .-> ACT
  AL -- held-light intents --> ROOM
  EQ -- device commands --> AV
  EQ <-- backlight power and readings --> WL
  ZP -- power readings --> EQ

  Adapt <-- subscribe and publish --> BROKER
  CON <-- requests in, retained state and discovery out --> BROKER
  BROKER <-- device topics --> DEV
  BROKER <-. entity state and set messages .-> HA
