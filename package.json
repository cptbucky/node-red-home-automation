{
  "name": "@avantics/node-red-home-automation",
  "version": "6.2.0",
  "description": "Deterministic home automation components for Node-RED",
  "keywords": [
    "node-red",
    "home-automation",
    "typescript",
    "lighting",
    "home-theatre",
    "mqtt"
  ],
  "funding": "https://ko-fi.com/avantics",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avantics-hq/node-red-home-automation.git"
  },
  "homepage": "https://github.com/avantics-hq/node-red-home-automation#readme",
  "bugs": {
    "url": "https://github.com/avantics-hq/node-red-home-automation/issues"
  },
  "license": "MIT",
  "files": [
    "dist/lib",
    "dist/nodes",
    "examples",
    "contract-examples",
    "!dist/**/*.js.map"
  ],
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc && node scripts/copy-node-html.mjs",
    "test": "npm run build && node --test dist/test/*.test.js && node contract-examples/run.mjs --verify",
    "examples": "npm run build && node contract-examples/run.mjs",
    "scan:public": "node scripts/check-public.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "prepack": "npm run build",
    "diagrams": "node scripts/render-diagrams.mjs",
    "docs": "node scripts/build-docs.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "node-red": {
    "version": ">=5.0.0",
    "nodes": {
      "home-occupancy-fusion": "dist/nodes/occupancy-fusion.js",
      "home-motion-lighting-policy": "dist/nodes/motion-policy.js",
      "home-switch-lighting-policy": "dist/nodes/switch-policy.js",
      "home-room-lighting-controller": "dist/nodes/room-controller.js",
      "home-z2m-light": "dist/nodes/z2m-light.js",
      "home-circadian-lighting-policy": "dist/nodes/circadian-policy.js",
      "home-scene": "dist/nodes/scene.js",
      "home-avr-controller": "dist/nodes/avr-controller.js",
      "home-display-mode-controller": "dist/nodes/display-mode-controller.js",
      "home-source-capability-controller": "dist/nodes/source-capability-controller.js",
      "home-activity-lighting-controller": "dist/nodes/activity-lighting-controller.js",
      "home-backlighting-controller": "dist/nodes/backlighting-controller.js",
      "home-theatre-activity-controller": "dist/nodes/theatre-activity-controller.js",
      "home-theatre-state-contract": "dist/nodes/theatre-state-contract.js",
      "home-house-schedule": "dist/nodes/house-schedule.js",
      "home-cover-controller": "dist/nodes/cover-controller.js",
      "home-cover-group": "dist/nodes/cover-group.js",
      "home-house-schedule-mqtt": "dist/nodes/house-schedule-mqtt.js",
      "home-shelly-cover": "dist/nodes/shelly-cover.js",
      "home-shelly-switch": "dist/nodes/shelly-switch.js",
      "home-z2m-cover": "dist/nodes/z2m-cover.js",
      "home-wled": "dist/nodes/wled.js",
      "home-z2m-sensor": "dist/nodes/z2m-sensor.js",
      "home-everything-presence-one": "dist/nodes/everything-presence-one.js",
      "home-apollo-r-pro-1": "dist/nodes/apollo-r-pro-1.js",
      "home-z2m-power": "dist/nodes/z2m-power.js"
    }
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/node-red": "1.3.5",
    "typescript": "7.0.2"
  }
}
